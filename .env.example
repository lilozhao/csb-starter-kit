# CSB Starter Kit · A2A 接入配置
# ─────────────────────────────────────────────────────────────
# 约定端口（CDP v0.1，勿随意改动）
#   3098/udp  CDP 广播探询口
#   3099      注册表（一网一个；CDP 会自动发现，这里是兜底种子）
#   3100      Agent 默认口（被占用时自动回退 3101–3199）
# ─────────────────────────────────────────────────────────────

# 你的 Agent 名字（决定注册名，建议唯一；重名会被注册表拒绝）
CDP_NAME=my-agent

# Agent 监听口：默认 3100（CDP 约定，写死）
CDP_PORT=3100

# 注册表：端口固定 3099；主机由 CDP 自动发现，这里是兜底种子
CDP_REGISTRY=http://csbc.lilozkzy.top:3099

# 可选：本机对外地址（不填则自动取本机内网 IP）
# CDP_HOST=192.168.1.10
